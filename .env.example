# Database Configuration (SQLite for local development/demo)
DATABASE_URL="file:./dev.db"

# Server Port
PORT=3000

# Application & WebSocket URLs
NEXT_PUBLIC_API_URL="http://localhost:3000"
SOCKET_URL="http://localhost:3000"

# Notification Service ("mock" for local hackathon demo, "twilio" for SMS)
NOTIFICATION_PROVIDER="mock"

# External Notification Credentials (Optional - leave empty for mock mode)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Optional Firebase / Push Notification Config
FIREBASE_CONFIG=""
